# ---- Database (required in production) ----------------------------------
# Any Postgres. On Vercel: Storage → Create → Neon / Supabase / Prisma Postgres.
# The integration adds DATABASE_URL (or POSTGRES_URL) to the project for you.
# The `inquiries` table is created automatically on first use.
# Locally, leave it unset to use an embedded PGlite database in .data/pglite.
DATABASE_URL=

# ---- Admin page (/admin) --------------------------------------------------
# Optional: the sign-in username. Defaults to "admin" when unset. Case-insensitive.
ADMIN_USERNAME=
# Required to sign in. Use a long random string.
ADMIN_PASSWORD=
# Optional: separate secret for signing the session cookie (derived from the username + password if unset).
ADMIN_SESSION_SECRET=

# ---- Look and feel --------------------------------------------------------
# Accent theme: violet (default), dracula, blue, cyan, lime, amber, rose, emerald, mono.
# Palettes live in app/globals.css. In `next dev` a picker in the bottom-right
# corner lets you try them on the real page before committing to one.
NEXT_PUBLIC_SITE_THEME=

# ---- Optional: also forward each inquiry as JSON (Slack, Zapier, n8n, your API) ----
INQUIRY_WEBHOOK_URL=
